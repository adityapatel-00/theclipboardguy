{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-is-visible",
    "core:window:allow-is-focused",
    "clipboard:read-all",
    "clipboard:write-all",
    "clipboard:monitor-all",
    "clipboard:allow-has-text",
    "clipboard:allow-has-image",
    "clipboard:allow-has-html",
    "clipboard:allow-has-rtf",
    "clipboard:allow-has-files",
    "clipboard:allow-available-types",
    "clipboard:allow-clear",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "positioner:default",
    "positioner:allow-move-window",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
